---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE } from '../config.js';
import hero from '../assets/foto-68.jpg';
import tempo1 from '../assets/foto-45.jpg';
import tempo2 from '../assets/foto-35.jpg';
import tempo3 from '../assets/foto-42.jpg';
import talkFoto from '../assets/foto-73.jpg';
import ctaFoto from '../assets/foto-125.jpg';
---
<Base
  title="Mónica Rodrigues | IT Leadership: liderança prática para managers em tecnologia"
  description="Ajudo managers e futuros managers em tecnologia a gerir melhor equipas, tempo e projetos. Liderança prática, por uma Engineering Manager que conhece o setor por dentro."
  path="/"
>
  <section class="hero">
    <div class="wrap">
      <div class="hero-texto">
        <p class="eyebrow">Engineering Manager · IT Leadership</p>
        <h1>Liderança prática para managers em tecnologia</h1>
        <p class="sub">
          Ajudo managers e futuros managers em IT a gerir melhor equipas, tempo e projetos,
          com a experiência de quem passou de developer a Engineering Manager.
        </p>
        <div class="botoes">
          <a class="btn btn-rosa" href="/sobre/">Conhece o meu percurso</a>
          <a class="btn btn-branco" href={SITE.social.instagram} rel="me noopener">Segue no Instagram</a>
        </div>
      </div>
      <figure>
        <Image
          src={hero}
          alt="Mónica Rodrigues a sorrir, de blazer azul, com a mão ao rosto"
          widths={[420, 640, 860]}
          sizes="(min-width: 860px) 440px, calc(100vw - 40px)"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="numeros" aria-label="Percurso">
    <div class="wrap">
      <ul>
        <li data-reveal><strong>Quase 10</strong><span>anos a liderar equipas</span></li>
        <li data-reveal><strong>2019</strong><span>Engineering Manager desde</span></li>
        <li data-reveal><strong>MVP</strong><span>reconhecida pela Microsoft</span></li>
      </ul>
      <p class="mais">Ex-embaixadora das Geek Girls Portugal · <a href="/sobre/#comunidade">ver comunidade e reconhecimento</a></p>
    </div>
  </section>

  <section class="seccao alt">
    <div class="wrap">
      <div class="intro">
        <p class="eyebrow">Sobre o que escrevo e falo</p>
        <h2>Os desafios reais de um manager em tecnologia</h2>
        <p>Menos teoria, mais exemplos de quem está no terreno: o que faço, o que correu mal e o que mudei.</p>
      </div>
      <ul class="pilares">
        <li class="pilar pessoas" data-reveal>
          <span class="num" aria-hidden="true">01</span>
          <h3>Pessoas</h3>
          <ul>
            <li>1:1 que realmente ajudam</li>
            <li>Feedback claro e humano</li>
            <li>Carreira e desenvolvimento de cada um</li>
            <li>Motivação, confiança e conflitos</li>
            <li>Delegar sem microgerir</li>
          </ul>
        </li>
        <li class="pilar entrega" data-reveal>
          <span class="num" aria-hidden="true">02</span>
          <h3>Entrega</h3>
          <ul>
            <li>Gerir as expectativas dos stakeholders</li>
            <li>Comunicar o estado com clareza</li>
            <li>Prioridades quando tudo é urgente</li>
            <li>Equilibrar qualidade técnica e trabalho de negócio</li>
            <li>Bloqueios e atrasos</li>
          </ul>
        </li>
        <li class="pilar processos" data-reveal>
          <span class="num" aria-hidden="true">03</span>
          <h3>Processos</h3>
          <ul>
            <li>Reuniões com objetivo e agenda</li>
            <li>Gerir bugs e technical debt sem os deixar para trás</li>
            <li>Rotinas e planeamento da semana</li>
            <li>Templates e documentação</li>
          </ul>
        </li>
        <li class="pilar jornada" data-reveal>
          <span class="num" aria-hidden="true">04</span>
          <h3>Jornada</h3>
          <ul>
            <li>De developer a líder</li>
            <li>Livros que me ajudaram</li>
            <li>Bastidores da liderança</li>
            <li>Aprender com os erros</li>
          </ul>
        </li>
      </ul>
    </div>
  </section>

  <section class="seccao bastidores">
    <div class="wrap">
      <div class="intro">
        <p class="eyebrow">Fora do trabalho</p>
        <h2>O que gosto de fazer nos tempos livres</h2>
        <ul class="chips">
          <li>Ler livros</li>
          <li>Fazer Legos</li>
          <li>Viajar pelo mundo</li>
          <li>Experimentar restaurantes</li>
          <li>Conviver com as pessoas</li>
        </ul>
      </div>
      <div class="fotos3">
        <figure data-reveal><Image src={tempo1} alt="Mónica a sorrir, abraçada a uma pilha de livros" style="object-position: 50% 50%" widths={[320, 520]} sizes="(min-width: 760px) 330px, 90vw" format="webp" quality={76} /></figure>
        <figure data-reveal><Image src={tempo2} alt="Mónica a ler um livro, com a cara meio tapada" style="object-position: 100% 50%" widths={[320, 520]} sizes="(min-width: 760px) 330px, 90vw" format="webp" quality={76} /></figure>
        <figure data-reveal><Image src={tempo3} alt="Mónica a espreitar, a sorrir, por entre uma fila de livros" style="object-position: 52% 50%" widths={[320, 520]} sizes="(min-width: 760px) 330px, 90vw" format="webp" quality={76} /></figure>
      </div>
    </div>
  </section>

  <section class="seccao destaque">
    <div class="wrap">
      <div class="destaque-grelha">
        <figure data-reveal><Image src={talkFoto} alt="Mónica a apontar, com um sorriso" widths={[320, 520]} sizes="(min-width: 860px) 320px, 70vw" format="webp" quality={78} /></figure>
        <div data-reveal>
          <p class="eyebrow">Talk · GDG Évora</p>
          <h2>O teu novo par de mãos: AI para engineering managers</h2>
          <p>A talk que dei em Évora a 14 de novembro de 2026, com a demo e o repositório num só sítio.</p>
          <div class="botoes">
            <a class="btn btn-rosa" href="/talk-evora/">Ver a talk</a>
            <a class="btn btn-branco" href="/talks/">Todas as talks</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="seccao">
    <div class="wrap">
      <div class="cartoes">
        <article class="cartao" data-reveal>
          <p class="eyebrow">Artigos</p>
          <h3>Escrevo no Medium</h3>
          <p>Partilho como faço os 1:1, as dailies e como leio e termino um livro, sempre na primeira pessoa.</p>
          <a class="btn btn-secundario" href="/artigos/">Ver os artigos</a>
        </article>
        <article class="cartao" data-reveal>
          <p class="eyebrow">Sobre mim</p>
          <h3>De developer a líder</h3>
          <p>O meu percurso, o que aprendi pelo caminho e o que me move fora do trabalho.</p>
          <a class="btn btn-secundario" href="/sobre/">Conhece o meu percurso</a>
        </article>
      </div>
    </div>
  </section>

  <section class="cta-final">
    <div class="wrap">
      <figure data-reveal><Image src={ctaFoto} alt="Mónica sentada num pufe, a ler, rodeada de livros" widths={[320, 520]} sizes="(min-width: 860px) 300px, 60vw" format="webp" quality={76} /></figure>
      <div data-reveal>
        <h2>Vamos conversar sobre liderança?</h2>
        <p>Segue o que partilho no dia a dia no Instagram e no LinkedIn, e diz-me o que gostavas de ver aqui.</p>
        <div class="botoes">
          <a class="btn btn-principal" href={SITE.social.instagram} rel="me noopener">Instagram</a>
          <a class="btn btn-secundario" href={SITE.social.linkedin} rel="me noopener">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</Base>
