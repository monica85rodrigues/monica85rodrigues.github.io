---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import { SITE } from '../config.js';
import { PILARES_ARTIGOS } from '../data/artigos.js';

const formatar = (iso) =>
  new Intl.DateTimeFormat('pt-PT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso));
---
<Base
  title="Artigos: liderança, bastidores e o que penso"
  description="Artigos de Mónica Rodrigues no Medium: o dia a dia de uma Engineering Manager (1:1, dailies, organização, decisões, equipas), os bastidores, viagens e pensamentos sobre a vida fora da área."
  path="/artigos/"
>
  <CabecalhoPagina eyebrow="Artigos" titulo="O que escrevo">
    <p>
      Escrevo no Medium sobre o que vivo e o que penso, sempre na primeira pessoa. Falo de liderança em tecnologia,
      mas também de bastidores, de viagens, de pensamentos mais filosóficos e de outros temas fora da minha área.
    </p>
  </CabecalhoPagina>
  <div class="wrap pagina">
    <div class="texto" style="max-width:none">
      <p class="aviso">
        <strong>Antes de leres:</strong> os artigos estão em inglês e alguns são antigos, por isso há práticas que já mudaram.
        Por exemplo, hoje faço os 1:1 de 15 em 15 dias, e no artigo eram mensais.
        No Medium vais encontrar também artigos dos meus tempos de developer e sobre outros temas, como ser feliz.
      </p>

      {PILARES_ARTIGOS.map((p) => (
        <section class={`sec-art ${p.id}`}>
          <h2 id={p.id} class="titulo-sec">{p.nome}</h2>
          <ul class="lista-talks">
            {p.artigos.map((a) => (
              <li data-reveal>
                <a href={a.url} rel="noopener">
                  <span class="data">Artigo em inglês · Medium{a.data ? ` · ${formatar(a.data)}` : ''}</span>
                  <span class="titulo">{a.titulo}</span>
                  <span class="contexto">{a.resumo}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <div class="botoes">
        <a class="btn btn-principal" href={SITE.social.medium} rel="me noopener">Ver todos no Medium</a>
      </div>
    </div>
  </div>
</Base>
