---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" description="Esta página não existe." path="/404/" noindex={true}>
  <div class="wrap pagina">
    <div class="texto">
      <p class="eyebrow">Erro 404</p>
      <h1>Esta página não existe</h1>
      <p>Pode ter mudado de sítio ou o endereço pode estar errado.</p>
      <div class="botoes">
        <a class="btn btn-principal" href="/">Voltar ao início</a>
        <a class="btn btn-secundario" href="https://github.com/monica85rodrigues/talk-evora-aiengmanagers" rel="noopener" target="_blank">Ver a apresentação de Évora</a>
      </div>
    </div>
  </div>
</Base>
